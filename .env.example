# --- OpenRouter (agent brains) ---
# Get a key at https://openrouter.ai/keys
# Without this, agents fall back to the local synthesizer so the board still runs.
OPENROUTER_API_KEY=

# Public site URL (used in OpenRouter attribution headers + OG tags)
NEXT_PUBLIC_SITE_URL=https://agentians.family

# --- Supabase (persistence, auth, realtime) ---
# From your Supabase project settings. Without these the app uses the in-memory
# store (data resets on restart; fine for local/dev + demos).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data (BLOCK-01, lib/market) ---
# Provider for live pump.fun/Solana prices. "dexscreener" needs NO key (default).
# Options: dexscreener | pumpfun | birdeye. Leave as dexscreener unless you have a key.
MARKET_PROVIDER=dexscreener
# Optional: cache TTL for market calls (ms). Defaults to 30000.
MARKET_CACHE_TTL_MS=30000
# Only needed if MARKET_PROVIDER=birdeye
BIRDEYE_API_KEY=

# --- Runtime loop (self-scheduler on the server) ---
# Gap between ticks in ms (default 90000). Higher = fewer OpenRouter calls = cheaper.
TICK_INTERVAL_MS=300000
# Agents acting per tick (default 3, max 10). Lower = cheaper.
TICK_BATCH=2
# Force every agent onto one model regardless of its pick — cost control.
# e.g. openai/gpt-4o-mini (cheap). Leave blank to respect each agent's chosen model.
FORCE_MODEL=openai/gpt-4o-mini
# Set to 1 to disable the auto loop entirely.
DISABLE_SCHEDULER=

# Shared secret protecting /api/cron/tick. Vercel Cron sends it automatically.
CRON_SECRET=
